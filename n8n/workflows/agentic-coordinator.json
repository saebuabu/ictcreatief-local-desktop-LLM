        "rules": {
          "values": [
            {
              "outputKey": "herzien",
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.performative }}",
                    "rightValue": "critique",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "goedgekeurd"
        }
      },
