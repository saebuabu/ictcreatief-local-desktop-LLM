      "name": "Ontvang bericht",
      "webhookId": "8b6f7a8b-1002-4000-8000-100000000002"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": { "__rl": true, "mode": "name", "value": "agentic-blackboard" },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "conversation_id",
              "condition": "eq",
              "keyValue": "={{ $json.body.conversation_id }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [460, 300],
      "id": "8a5b5c5d-1006-4000-8000-100000000006",
      "name": "Haal taak op"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "p1",
              "name": "prompt",
              "value": "={{ $('Ontvang bericht').item.json.body.performative === 'revise' ? ('Oorspronkelijke taak: ' + $json.task + '\\n\\nJouw vorige antwoord: ' + $json.worker_antwoord + '\\n\\nKritiek van de Criticus: ' + $json.kritiek + '\\n\\nHerzie je antwoord op basis van deze kritiek.') : $json.task }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 300],
      "id": "8a6b6c6d-1007-4000-8000-100000000007",
      "name": "Bouw prompt"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\": \"llama3.1:8b\", \"prompt\": $json.prompt, \"stream\": false } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [900, 300],
      "id": "8a2b2c2d-1003-4000-8000-100000000003",
      "name": "Vraag Ollama"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "upsert",
        "dataTableId": { "__rl": true, "mode": "name", "value": "agentic-blackboard" },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "conversation_id",
              "condition": "eq",
              "keyValue": "={{ $('Ontvang bericht').item.json.body.conversation_id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "conversation_id": "={{ $('Ontvang bericht').item.json.body.conversation_id }}",
            "worker_antwoord": "={{ $json.response }}",
            "herzien": "={{ $('Ontvang bericht').item.json.body.performative === 'revise' }}",
            "status": "={{ $('Ontvang bericht').item.json.body.performative === 'revise' ? 'herzien_wacht_op_critic' : 'wacht_op_critic' }}"
          },
          "schema": [
            { "id": "conversation_id", "displayName": "conversation_id", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "worker_antwoord", "displayName": "worker_antwoord", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "herzien", "displayName": "herzien", "required": false, "defaultMatch": false, "display": true, "type": "boolean", "canBeUsedToMatch": true },
            { "id": "status", "displayName": "status", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [1120, 300],
      "id": "8a7b7c7d-1008-4000-8000-100000000008",
      "name": "Sla antwoord op"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "conversation_id",
              "value": "={{ $('Ontvang bericht').item.json.body.conversation_id }}",
              "type": "string"
            },
            {
              "id": "b2",
              "name": "message_id",
              "value": "={{ 'worker-' + $now.toMillis() }}",
              "type": "string"
            },
            {
              "id": "b3",
              "name": "from",
              "value": "worker",
              "type": "string"
            },
            {
              "id": "b4",
              "name": "to",
              "value": "coordinator",
              "type": "string"
            },
            {
              "id": "b5",
              "name": "performative",
              "value": "inform",
              "type": "string"
            },
            {
              "id": "b6",
              "name": "content",
              "value": "={{ $json.worker_antwoord }}",
              "type": "string"
            },
            {
              "id": "b7",
              "name": "meta.model",
              "value": "ollama:llama3.1:8b",
              "type": "string"
            },
            {
              "id": "b8",
              "name": "meta.timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1340, 300],
      "id": "8a3b3c3d-1004-4000-8000-100000000004",
      "name": "Bouw inform-bericht"
    },
    {
      "parameters": {
        "respondWith": "json",
