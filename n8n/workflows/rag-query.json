{
  "id": "ragQuery01",
  "name": "RAG - Query kennisbank",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rag-query",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 300],
      "id": "6a1b1c1d-6001-4000-8000-600000000001",
      "name": "Ontvang vraag",
      "webhookId": "6b6f7a8b-6002-4000-8000-600000000002"
    },
    {
      "parameters": {
        "mode": "load",
        "qdrantCollection": {
          "__rl": true,
          "mode": "id",
          "value": "mbo-kennisbank"
        },
        "prompt": "={{ $json.body.content }}",
        "topK": 4,
        "includeDocumentMetadata": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [220, 300],
      "id": "6a2b2c2d-6003-4000-8000-600000000003",
      "name": "Zoek in kennisbank"
    },
    {
      "parameters": {
        "model": "nomic-embed-text"
      },
      "type": "@n8n/n8n-nodes-langchain.embeddingsOllama",
      "typeVersion": 1,
      "position": [220, 520],
      "id": "6a3b3c3d-6004-4000-8000-600000000004",
      "name": "Embeddings Ollama"
    },
    {
      "parameters": {
        "aggregate": "aggregateIndividualFields",
        "fieldsToAggregate": {
          "fieldToAggregate": [
            {
              "fieldToAggregate": "document.pageContent",
              "renameField": true,
              "outputFieldName": "fragmenten"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [440, 300],
      "id": "6a4b4c4d-6005-4000-8000-600000000005",
      "name": "Verzamel fragmenten"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "q1",
              "name": "conversation_id",
              "value": "={{ $('Ontvang vraag').item.json.body.conversation_id }}",
              "type": "string"
            },
            {
              "id": "q2",
              "name": "message_id",
              "value": "={{ 'rag-query-' + $now.toMillis() }}",
              "type": "string"
            },
            {
              "id": "q3",
              "name": "from",
              "value": "rag-query",
              "type": "string"
            },
            {
              "id": "q4",
              "name": "to",
              "value": "={{ $('Ontvang vraag').item.json.body.from }}",
              "type": "string"
            },
            {
              "id": "q5",
              "name": "performative",
              "value": "tool-result",
              "type": "string"
            },
            {
              "id": "q6",
              "name": "content",
              "value": "={{ $json.fragmenten && $json.fragmenten.length ? $json.fragmenten.join('\\n\\n---\\n\\n') : '(geen relevante informatie gevonden in de kennisbank)' }}",
              "type": "string"
            },
            {
              "id": "q7",
              "name": "meta.model",
              "value": "ollama:nomic-embed-text",
              "type": "string"
            },
            {
              "id": "q8",
              "name": "meta.aantal_fragmenten",
              "value": "={{ $json.fragmenten ? $json.fragmenten.length : 0 }}",
              "type": "number"
            },
            {
              "id": "q9",
              "name": "meta.timestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [660, 300],
      "id": "6a5b5c5d-6006-4000-8000-600000000006",
      "name": "Bouw tool-result bericht"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [880, 300],
      "id": "6a6b6c6d-6007-4000-8000-600000000007",
      "name": "Antwoord"
    }
  ],
  "connections": {
    "Ontvang vraag": {
      "main": [[{ "node": "Zoek in kennisbank", "type": "main", "index": 0 }]]
    },
    "Zoek in kennisbank": {
      "main": [[{ "node": "Verzamel fragmenten", "type": "main", "index": 0 }]]
    },
    "Embeddings Ollama": {
      "ai_embedding": [[{ "node": "Zoek in kennisbank", "type": "ai_embedding", "index": 0 }]]
    },
    "Verzamel fragmenten": {
      "main": [[{ "node": "Bouw tool-result bericht", "type": "main", "index": 0 }]]
    },
    "Bouw tool-result bericht": {
      "main": [[{ "node": "Antwoord", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
