# Open WebUI configuratie

# Poort waarop Open WebUI bereikbaar is in de browser
WEBUI_PORT=3000

# URL naar de Ollama instantie (draait native op Windows)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Docker image tag (main = nieuwste versie, of pin op bijv. v0.4.0)
WEBUI_IMAGE_TAG=main

# n8n configuratie
# Poort waarop n8n bereikbaar is in de browser
N8N_PORT=5678

# Docker image tag (latest = nieuwste versie)
N8N_IMAGE_TAG=latest

# Let op: n8n gebruikt geen .env-inloggegevens meer (N8N_BASIC_AUTH_* wordt genegeerd
# sinds n8n 1.x). Bij het eerste bezoek aan http://localhost:5678 maak je zelf een
# owner-account aan (e-mail + wachtwoord) — zie docs/n8n-setup.md.
